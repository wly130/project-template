# pnpm dependencies and local pnpm store
node_modules/
.pnpm-store/

# Compiled Node/TS artifacts, caches and framework-generated files
dist/
build/
out/
.next/
.nuxt/
.output/
.cache/
.turbo/
*.tsbuildinfo
.eslintcache

# Test/coverage/e2e artifacts
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# Logs, temporary files
*.log
logs/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
*.tmp
*.swp
*~

# All actual env profiles are private, but the example stays tracked
.env
.env.*
!.env.example
!.env.*.example

# Sensitive keys and OS/editor files
*.pem
*.key
*.p12
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.iml

# Never ignore pnpm-lock.yaml, package.json, source, database migrations.
/log/
/logs/
