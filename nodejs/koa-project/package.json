        "@koa/bodyparser": "^6.1.0"
    },
    "devDependencies": {
        "@types/koa": "^3.0.3",
        "@types/node": "^24.19.2",
        "nodemon": "^3.1.14",
        "tsx": "^4.23.15",
        "typescript": "~7.0.2"
    }
}
