# Server
IP_ADDRESS=localhost
PORT=3000

# Token
TOKEN_ACCESS_KEY=your-secret-key
ACCESS_TIME=1h
REFRESH_TIME=7d

# Database
DB_TYPE=mysql
DB_DATE_BASE_NAME=project
DB_USERNAME=root
DB_PASSWORD=12345678
DB_HOST=127.0.0.1
DB_PORT=3306

# TypeORM options
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false
ENABLE_MYSQL=false
